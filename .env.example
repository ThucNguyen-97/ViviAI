# ============================================================
# .env.example - Copy to .env and fill real values.
# Do not commit the real .env file.
# ============================================================

# PostgreSQL
POSTGRES_USER=vietmas
POSTGRES_PASSWORD=changeme_strong_password
POSTGRES_DB=vietmas_db

# Redis (Laptop - Enterprise Knowledge)
REDIS_EK_PASSWORD=changeme_ek_password

# Redis (VM - Queue & runtime state)
REDIS_VM_PASSWORD=changeme_vm_password

# Firebase
FIREBASE_PROJECT_ID=your-firebase-project-id
# Place the service account JSON at: ./secrets/firebase-service-account.json

# App
APP_ENV=development
USD_TO_VND_RATE=26200
# Future frontend display conversion. Backend stores and calculates canonical cost in USD.
NEXT_PUBLIC_USD_TO_VND_RATE=26200

# Official LLM providers
GOOGLE_API_KEY=your_google_api_key
ANTHROPIC_API_KEY=your_anthropic_api_key

# Model routing defaults
GOOGLE_LLM_MODEL=gemini-3.1-flash-lite
ANTHROPIC_LLM_MODEL=claude-sonnet-5

# LLM pricing defaults, USD per 1M tokens
GOOGLE_INPUT_USD_PER_MTOK=0.25
GOOGLE_OUTPUT_USD_PER_MTOK=1.50
ANTHROPIC_INPUT_USD_PER_MTOK=3.00
ANTHROPIC_OUTPUT_USD_PER_MTOK=15.00

# Email MCP / SMTP (leave blank to disable actual sending)
EMAIL_SMTP_HOST=
EMAIL_SMTP_PORT=587
EMAIL_SMTP_FROM=
EMAIL_SMTP_USERNAME=
EMAIL_SMTP_PASSWORD=
EMAIL_SMTP_TLS=true
EMAIL_IMAP_HOST=imap.gmail.com
EMAIL_IMAP_PORT=993
EMAIL_IMAP_MAILBOX=INBOX
EMAIL_IMAP_PARTNER_MAILBOX=Partner
EMAIL_IMAP_SENT_MAILBOX=[Gmail]/Sent Mail
EMAIL_IMAP_USERNAME=
EMAIL_IMAP_PASSWORD=

# RAG retrieval defaults
RAG_DEFAULT_TOP_K=5
RAG_DEFAULT_SCORE_THRESHOLD=0.7

# Internal service-to-service API between VM and Enterprise Knowledge.
# Use the same value on Laptop tier and VM tier during LAN/demo.
EK_INTERNAL_API_KEY=change_me_to_a_long_random_value
